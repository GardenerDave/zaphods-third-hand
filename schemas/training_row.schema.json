{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "messages": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "type": "string"
          },
          "role": {
            "enum": [
              "system",
              "user",
              "assistant"
            ],
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "type": "object"
      },
      "minItems": 2,
      "type": "array"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "messages"
  ],
  "title": "Training Row",
  "type": "object"
}
