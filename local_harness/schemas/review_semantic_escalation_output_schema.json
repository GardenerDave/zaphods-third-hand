{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "unsupported_claims",
    "internal_consistency",
    "review_reason"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "pass_review",
        "hold"
      ]
    },
    "unsupported_claims": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "reason",
          "evidence"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "detail"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "detail": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "internal_consistency": {
      "type": "string",
      "enum": [
        "consistent",
        "inconsistent"
      ]
    },
    "review_reason": {
      "type": "string",
      "minLength": 1
    }
  }
}
