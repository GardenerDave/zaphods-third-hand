# Copy to config.env or export these values in your shell. Uncomment to use options.

# Core ZTH workflows expect an existing OpenAI-compatible endpoint.
# Optional exploratory llama.cpp lifecycle support is documented under
# local_harness/model_auditions/; it is not production server management.
# Required for model-backed runs: set these to your own OpenAI-compatible endpoint.
# URL must match your endpoint base and include /v1 where required.
# Model must match an id exposed by your endpoint.
export ZTH_BASE_URL="http://127.0.0.1:8080/v1"
export ZTH_MODEL="your-model-name"

# Optional endpoint auth.
# export OPENAI_API_KEY="<YOUR_PRIVATE_KEY>"

# Optional distiller overrides.
# Default chunk size is 350 source lines. Smaller values are useful for smoke
# tests or slower model servers.
# export ZTH_DISTILLER_CHUNK_LINES="200"
# Default output budgets: chunk=1200, session=2200, patch=1800; timeout=900.
# export ZTH_DISTILLER_CHUNK_MAX_TOKENS="600"
# Token-efficient compact profile:
# export ZTH_DISTILLER_SESSION_MAX_TOKENS="700"
# export ZTH_DISTILLER_PATCH_MAX_TOKENS="280"
# export ZTH_DISTILLER_TIMEOUT="900"
# Set to 1 for endpoints/models that need a final-answer-only hint such as /no_think.
# export ZTH_DISTILLER_FINAL_ONLY="1"
# Optional labels recorded in METRICS.json for advisor filtering.
# Common profiles: smoke, normal, chunked, custom.
# Common purposes: connectivity, tuning, handoff, production, test.
# export ZTH_DISTILLER_RUN_PROFILE="normal"
# export ZTH_DISTILLER_RUN_PURPOSE="handoff"

# Optional multi-endpoint role routing for local_harness/icm_call.py.
# These are separate from the primary ZTH_BASE_URL/ZTH_MODEL pair.
# export ICM_DEEP_API="openai-chat"
# export ICM_DEEP_BASE_URL="http://127.0.0.1:8081/v1"
# export ICM_DEEP_MODEL="your-deep-model-id"
# export ICM_CODER_BASE_URL="http://127.0.0.1:8082/v1"
# export ICM_CODER_MODEL="your-coder-model-id"
# export ICM_ROUTER_BASE_URL="http://127.0.0.1:8083/v1"
# export ICM_ROUTER_MODEL="your-router-model-id"

# Optional supervised capability-mining ladder. The worker is the small local
# model; the teacher is the larger local model. External teaching is disabled
# unless an operator explicitly configures a noninteractive adapter command.
# export ZTH_CAPABILITY_WORKER_NAME="router"
# export ZTH_CAPABILITY_WORKER_BASE_URL="<PRIVATE_WORKER_BASE_URL>"
# export ZTH_CAPABILITY_WORKER_MODEL="qwen3-1.7b-gpu-40k"
# export ZTH_CAPABILITY_TEACHER_NAME="handoff"
# export ZTH_CAPABILITY_TEACHER_BASE_URL="<PRIVATE_TEACHER_BASE_URL>"
# export ZTH_CAPABILITY_TEACHER_MODEL="Qwen3-Coder-30B-A3B-Instruct-Q4_K_M.gguf"
# export ZTH_EXTERNAL_TEACHER_IDENTITY="codex"
# export ZTH_EXTERNAL_TEACHER_COMMAND="<operator-configured-noninteractive-adapter>"
# export ZTH_PUBLIC_HOST_ALIAS="JARVIS_LOCAL"
# Optional descriptive resource telemetry labels; never inferred from model names.
# export ZTH_CAPABILITY_WORKER_HARDWARE=""
# export ZTH_CAPABILITY_TEACHER_HARDWARE=""
# export ZTH_EXTERNAL_TEACHER_SERVICE_CLASS=""
