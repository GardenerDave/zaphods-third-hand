# Copy to config.env or export these values in your shell. Uncomment to use options.

export ZTH_BASE_URL="http://<LLAMA_CPP_BASE_URL>/v1"
export ZTH_MODEL="<MODEL_NAME>"
# Optional for endpoints that require authorization. 
# export ZTH_API_KEY="<YOUR_PRIVATE_KEY>"

# Optional overrides.
export ZTH_DISTILLER_CHUNK_LINES="350"
# Smaller values are useful for smoke tests or slower model servers.
# Defaults: chunk=1200, session=2200, patch=1800, timeout=900.
# export ZTH_DISTILLER_CHUNK_MAX_TOKENS="600"
# Token-efficient compact profile:
# export ZTH_DISTILLER_SESSION_MAX_TOKENS="700"
# export ZTH_DISTILLER_PATCH_MAX_TOKENS="280"
# export ZTH_DISTILLER_TIMEOUT="900"
# Set to 1 for endpoints/models that need a final-answer-only hint such as /no_think.
# export ZTH_DISTILLER_FINAL_ONLY="1"
# export ZTH_DEEP_BASE_URL="http://<LLAMA_CPP_BASE_URL>/v1"
# export ZTH_DEEP_MODEL="<MODEL_NAME>"
